<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.open-trader.frontend-gateway</string>

  <key>WorkingDirectory</key>
  <string>OPEN_TRADER_REPO</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONPATH</key>
    <string>OPEN_TRADER_REPO/src</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>OPEN_TRADER_PYTHON</string>
    <string>-m</string>
    <string>open_trader</string>
    <string>frontend-gateway</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8766</string>
    <string>--upstream-host</string>
    <string>127.0.0.1</string>
    <string>--upstream-port</string>
    <string>8767</string>
    <string>--account-upstream-host</string>
    <string>127.0.0.1</string>
    <string>--account-upstream-port</string>
    <string>8768</string>
    <string>--public-origin</string>
    <string>http://127.0.0.1:8766</string>
    <string>--static-dir</string>
    <string>OPEN_TRADER_REPO/src/open_trader/dashboard_static</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>OPEN_TRADER_REPO/logs/frontend_gateway/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>OPEN_TRADER_REPO/logs/frontend_gateway/launchd.err.log</string>
</dict>
</plist>
