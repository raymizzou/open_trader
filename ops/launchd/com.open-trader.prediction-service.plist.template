<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.open-trader.prediction-service</string>
  <key>WorkingDirectory</key><string>OPEN_TRADER_REPO</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONPATH</key><string>OPEN_TRADER_REPO/src</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>OPEN_TRADER_PYTHON</string><string>-m</string><string>open_trader</string><string>prediction-service</string>
    <string>--mode</string><string>OPEN_TRADER_PREDICTION_MODE</string><string>--data-dir</string><string>OPEN_TRADER_DATA_DIR</string>
    <string>--config</string><string>OPEN_TRADER_PREDICTION_CONFIG</string><string>--host</string><string>127.0.0.1</string><string>--port</string><string>8769</string>
    <string>--notifier-config</string><string>OPEN_TRADER_NOTIFIER_CONFIG</string>
    <string>--release-manifest</string><string>OPEN_TRADER_RELEASE_MANIFEST</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ProcessType</key><string>Interactive</string><key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>OPEN_TRADER_RUNTIME_ROOT/logs/prediction_service/launchd.out.log</string>
  <key>StandardErrorPath</key><string>OPEN_TRADER_RUNTIME_ROOT/logs/prediction_service/launchd.err.log</string>
</dict></plist>
