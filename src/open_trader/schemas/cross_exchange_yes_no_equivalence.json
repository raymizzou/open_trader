{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "summary",
    "predict",
    "polymarket",
    "direct_outcome_mapping",
    "canonical_cutoff",
    "contract_shape",
    "divergent_states",
    "evidence",
    "uncertainties"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "decision": { "enum": ["APPROVE", "REJECT"] },
    "summary": { "type": "string" },
    "predict": { "$ref": "#/$defs/predict_market" },
    "polymarket": { "$ref": "#/$defs/polymarket_market" },
    "direct_outcome_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predict_yes", "predict_no", "polymarket_yes", "polymarket_no"],
      "properties": {
        "predict_yes": { "type": "string" },
        "predict_no": { "type": "string" },
        "polymarket_yes": { "type": "string" },
        "polymarket_no": { "type": "string" }
      }
    },
    "canonical_cutoff": { "type": "string" },
    "contract_shape": { "enum": ["BINARY", "COMPOUND"] },
    "divergent_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PREDICT_YES_POLYMARKET_NO", "POLYMARKET_YES_PREDICT_NO"],
      "properties": {
        "PREDICT_YES_POLYMARKET_NO": { "$ref": "#/$defs/divergent_state" },
        "POLYMARKET_YES_PREDICT_NO": { "$ref": "#/$defs/divergent_state" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "predict_market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exchange", "market_id", "condition_id", "rules_fingerprint"],
      "properties": {
        "exchange": { "const": "predict.fun" },
        "market_id": { "type": "string" },
        "condition_id": { "type": "string" },
        "rules_fingerprint": { "type": "string" }
      }
    },
    "polymarket_market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exchange", "market_id", "condition_id", "rules_fingerprint"],
      "properties": {
        "exchange": { "const": "polymarket" },
        "market_id": { "type": "string" },
        "condition_id": { "type": "string" },
        "rules_fingerprint": { "type": "string" }
      }
    },
    "divergent_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["possible", "reason"],
      "properties": {
        "possible": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exchange", "field", "quote"],
      "properties": {
        "exchange": { "enum": ["predict.fun", "polymarket"] },
        "field": { "type": "string" },
        "quote": { "type": "string" }
      }
    }
  }
}
