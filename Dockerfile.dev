FROM astral/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv
FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e AS dev

COPY --from=uv /uv /usr/local/bin/uv
LABEL org.open-trader.image-role="test-only"
ARG SOURCE_SHA=unknown
ARG SOURCE_STATE=unknown
ENV OPEN_TRADER_TEST_SOURCE_SHA=$SOURCE_SHA \
    OPEN_TRADER_TEST_SOURCE_STATE=$SOURCE_STATE

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OPENSSL_armcap=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --no-install-recommends -y bash git zsh make nodejs procps \
    && printf '%s\n' \
        '#!/usr/local/bin/python3' \
        'import plistlib' \
        'import sys' \
        '' \
        'if len(sys.argv) != 3 or sys.argv[1] != "-lint":' \
        '    raise SystemExit(1)' \
        'try:' \
        '    with open(sys.argv[2], "rb") as stream:' \
        '        plistlib.load(stream)' \
        'except (OSError, plistlib.InvalidFileException, ValueError):' \
        '    raise SystemExit(1)' \
        'print(f"{sys.argv[2]}: OK")' \
        > /usr/bin/plutil \
    && chmod 0755 /usr/bin/plutil \
    && mkdir -p /usr/libexec \
    && printf '%s\n' \
        '#!/usr/local/bin/python3' \
        'import plistlib' \
        'import sys' \
        '' \
        'if len(sys.argv) != 4 or sys.argv[1] != "-c" or sys.argv[2] != "Print :WorkingDirectory":' \
        '    raise SystemExit(1)' \
        'try:' \
        '    with open(sys.argv[3], "rb") as stream:' \
        '        value = plistlib.load(stream).get("WorkingDirectory")' \
        'except (OSError, plistlib.InvalidFileException, ValueError):' \
        '    raise SystemExit(1)' \
        'if not isinstance(value, str):' \
        '    raise SystemExit(1)' \
        'print(value)' \
        > /usr/libexec/PlistBuddy \
    && chmod 0755 /usr/libexec/PlistBuddy \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap only the locked build backend before building locked source archives
# (futu-api ships no wheel). No isolated build can download unreviewed tooling.
COPY pyproject.toml uv.lock /workspace/
RUN uv sync --locked --only-group build --no-build \
    && uv sync --locked --no-default-groups --group build --extra dev --extra cloud-ssm --no-install-project --no-build-isolation

COPY . /workspace
RUN uv sync --locked --offline --no-default-groups --group build --extra dev --extra cloud-ssm --no-build-isolation \
    && git init --quiet /workspace \
    && git -C /workspace config user.name "open-trader-test" \
    && git -C /workspace config user.email "open-trader-test@example.invalid" \
    && git -C /workspace add -A \
    && GIT_AUTHOR_DATE="2026-01-01T00:00:00+00:00" \
       GIT_COMMITTER_DATE="2026-01-01T00:00:00+00:00" \
       git -C /workspace commit --quiet --allow-empty -m "Synthetic test snapshot"
